#!/bin/bash
#
# Komorebi post-install / upgrade script.
#
# Runs as root (dpkg maintainer script, or via CMake at `make install`).
# Hardened: strict mode, quoted expansions, no unbounded globbing of
# untrusted names, and no blanket recursive deletes.

set -euo pipefail

WALLPAPERS_DIR="/System/Resources/Komorebi"
DESKTOP_FILE="/usr/share/applications/komorebi.desktop"

echo "[INFO]: Updating existing Komorebi user setup.."

# Iterate only real login users (UID >= 1000) with an existing home dir,
# read from the passwd database instead of globbing /home/*.
while IFS=: read -r user _ uid _ _ home _; do

	# Skip system accounts and anything without a usable home directory.
	[ "$uid" -ge 1000 ] 2>/dev/null || continue
	[ -d "$home" ] || continue

	# Remove the legacy properties file (a plain file, never recurse).
	if [ -f "$home/.Komorebi.prop" ]; then
		rm -f "$home/.Komorebi.prop"
	fi

	# Install the autostart entry for this user.
	if [ -f "$DESKTOP_FILE" ]; then
		install -d -o "$user" -g "$user" "$home/.config/autostart"
		install -m 0644 -o "$user" -g "$user" \
			"$DESKTOP_FILE" "$home/.config/autostart/komorebi.desktop"
	fi

done < /etc/passwd

# Nothing to migrate if the wallpapers directory is missing.
if [ ! -d "$WALLPAPERS_DIR" ]; then
	echo "[INFO]: No wallpapers directory at $WALLPAPERS_DIR, skipping migration."
	exit 0
fi

echo "[INFO]: Migrating legacy Komorebi wallpapers.."

# Iterate wallpaper directories safely (handles spaces / odd names).
find "$WALLPAPERS_DIR" -mindepth 1 -maxdepth 1 -type d -print0 |
while IFS= read -r -d '' wallpaper; do

	# Skip already-migrated wallpapers (new-format video/image packs).
	if [ -e "$wallpaper/video.mp4" ] || [ -e "$wallpaper/wallpaper.jpg" ]; then
		continue
	fi

	base="$(basename "$wallpaper")"

	# Remove incompatible legacy wallpapers.
	case "$base" in
		blue_pink_gradient|dark_night_gradient)
			continue
			;;
	esac

	config="$wallpaper/config"
	[ -f "$config" ] || continue

	echo "Updating $base"

	configtemplate="[Info]
WallpaperType=image

[DateTime]
Visible=true
Parallax=DATETIMEPARALLAX

MarginLeft=MARGINLEFT
MarginTop=MARGINTOP
MarginBottom=MARGINBOTTOM
MarginRight=MARGINRIGHT

RotationX=0
RotationY=0
RotationZ=0

Position=POSITION
Alignment=ALIGNMENT
AlwaysOnTop=DATETIMEALWAYSONTOP

Color=TIMECOLOR
Alpha=255

ShadowColor=black
ShadowAlpha=190

TimeFont=TIMEFONT
DateFont=DATEFONT

[Wallpaper]
Parallax=WALLPAPERPARALLAX

[Asset]
Visible=ASSETVISIBLE
AnimationMode=ANIMATIONMODE
AnimationSpeed=ANIMATIONSPEED

Width=0
Height=0
"

	# Migrate the old bg.jpg -> wallpaper.jpg and drop the stale thumbnail.
	if [ -e "$wallpaper/bg.jpg" ]; then
		mv "$wallpaper/bg.jpg" "$wallpaper/wallpaper.jpg" 2>/dev/null || true
	fi
	rm -f "$wallpaper/thumb.jpg"

	halign=""
	valign=""

	while IFS= read -r line; do

		case "$line" in
			*=*) ;;
			*) continue ;;
		esac

		key="${line%%=*}"
		value="${line#*=}"

		case "$key" in
			DateTimeBoxParallax)   configtemplate="${configtemplate/DATETIMEPARALLAX/$value}" ;;
			AnimationMode)
				if [ "$value" = "parallax-bg" ]; then
					configtemplate="${configtemplate/WALLPAPERPARALLAX/true}"
					configtemplate="${configtemplate/ANIMATIONMODE/noanimation}"
				else
					configtemplate="${configtemplate/WALLPAPERPARALLAX/false}"
					configtemplate="${configtemplate/ANIMATIONMODE/$value}"
				fi
				;;
			AnimationSpeed)        configtemplate="${configtemplate/ANIMATIONSPEED/$value}" ;;
			DateTimeBoxMarginLeft)   configtemplate="${configtemplate/MARGINLEFT/$value}" ;;
			DateTimeBoxMarginTop)    configtemplate="${configtemplate/MARGINTOP/$value}" ;;
			DateTimeBoxMarginBottom) configtemplate="${configtemplate/MARGINBOTTOM/$value}" ;;
			DateTimeBoxMarginRight)  configtemplate="${configtemplate/MARGINRIGHT/$value}" ;;
			TimeLabelAlignment)      configtemplate="${configtemplate/ALIGNMENT/$value}" ;;
			DateTimeBoxHAlign)       halign="$value" ;;
			DateTimeBoxVAlign)       valign="$value" ;;
			DateTimeColor)           configtemplate="${configtemplate/TIMECOLOR/$value}" ;;
			TimeLabelFont)           configtemplate="${configtemplate/TIMEFONT/$value}" ;;
			DateLabelFont)           configtemplate="${configtemplate/DATEFONT/$value}" ;;
			DateTimeBoxOnTop)        configtemplate="${configtemplate/DATETIMEALWAYSONTOP/$value}" ;;
		esac

	done < "$config"

	if [ -e "$wallpaper/assets.png" ]; then
		configtemplate="${configtemplate/ASSETVISIBLE/true}"
	else
		configtemplate="${configtemplate/ASSETVISIBLE/false}"
	fi

	position=""
	case "$halign" in
		*start*)
			case "$valign" in
				*start*)  position="top_left" ;;
				*center*) position="center_left" ;;
				*end*)    position="bottom_left" ;;
			esac
			;;
		*center*)
			case "$valign" in
				*start*)  position="top_center" ;;
				*center*) position="center" ;;
				*end*)    position="bottom_center" ;;
			esac
			;;
		*end*)
			case "$valign" in
				*start*)  position="top_right" ;;
				*center*) position="center_right" ;;
				*end*)    position="bottom_right" ;;
			esac
			;;
	esac

	if [ -n "$position" ]; then
		configtemplate="${configtemplate/POSITION/$position}"
	fi

	printf '%s\n' "$configtemplate" > "$config"

done

echo "[INFO]: Migration complete."
